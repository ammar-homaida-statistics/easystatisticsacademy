---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}
    {% assign route_last_char = page.url | slice: -1, 1 %}
    {% assign sitemap_public_page = false %}
    {% if route_last_char == "/" %}
      {% assign sitemap_public_page = true %}
    {% elsif page.url contains ".html" and page.layout == "default" %}
      {% assign sitemap_public_page = true %}
    {% endif %}
    {% if sitemap_public_page and page.url != "/404.html" and page.robots_noindex != true %}
  <url>
    <loc>{{ site.url | append: page.url | xml_escape }}</loc>
    {% if page.last_modified_at %}
    <lastmod>{{ page.last_modified_at | date: "%Y-%m-%d" }}</lastmod>
    {% endif %}
  </url>
    {% endif %}
  {% endfor %}
</urlset>
